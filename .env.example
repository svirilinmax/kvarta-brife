# Supabase Transaction Pooler (порт 6543)
# ВАЖНО: ?prepared_statement_cache_size=0 обязателен для asyncpg + pooler
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?prepared_statement_cache_size=0

# development | production
ENVIRONMENT=development